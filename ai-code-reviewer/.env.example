# API keys only: uncomment the variable named by llm.api_key_env in config.yaml.
# The protocol is selected in config.yaml; the variable name is only a secret lookup key.
# Examples:
DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# GitHub credentials, when using review-pr or serve:
# GITHUB_TOKEN=your-github-token
