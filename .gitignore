# Nested repository metadata backups. The SRP root is the only Git repository.
**/.git.backup/
**/.git/

# Python caches and environments
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/ENV/

# Build artifacts
**/build/
**/dist/
**/*.egg-info/

# IDE and editor files
.vscode/
.idea/
.cursor/
**/*.swp
**/*.swo

# Secrets and local configuration
**/.env
**/.env.*
**/config.yaml
**/*.pem
**/.secrets/

# Logs and temporary files
**/*.log
**/logs/
**/tmp/
**/temp/

# Generated outputs and downloaded repositories
**/output/
**/demo/output/*
!**/demo/output/.gitkeep
**/repos/
**/indexes/

# OS files
.DS_Store
Thumbs.db

# Local generated demo/API test artifacts
**/output-api-fallback/
**/tmp_ai_reviewer_debug.txt
**/.git.backup

